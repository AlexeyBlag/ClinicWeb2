@page "/clients"
@using ClinicWeb.Models
@using ClinicWeb.Services
@inject IClientRepository ClientRepository
@rendermode InteractiveServer

<PageTitle>Клиенты - VetClinic</PageTitle>

<div class="page-header">
    <h1>👥 Клиенты</h1>
    <a href="/client-create" class="btn btn-primary">
        <span>➕</span> Добавить клиента
    </a>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Ошибка:</strong> @errorMessage
    </div>
}

@if (clients == null)
{
    <div class="loading">Загрузка данных...</div>
}
else if (!clients.Any())
{
    <div class="alert alert-info">
        Список клиентов пуст. <a href="/client-create">Добавьте первого!</a>
    </div>
}
else
{
    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>ФИО</th>
                    <th>Телефон</th>
                    <th>Email</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in clients)
                {
                    var rowNumber = clients.IndexOf(client) + 1;
                    <tr>
                        <td>@rowNumber</td>
                        <td><strong>@client.FullName</strong></td>
                        <td>@client.Phone</td>
                        <td>@client.Email</td>
                        <td>
                            <div class="btn-group">
                                <a href="/client/@client.Id" class="btn-sm btn-info">
                                    📄 Подробнее
                                </a>
                                <button type="button"
                                        @onclick="() => HandleDeleteClick(client.Id)"
                                        class="btn-sm btn-danger">
                                    🗑️ Удалить
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Client>? clients;
    private string? errorMessage;
    private int? deletingId; 

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("=== Загрузка клиентов ===");
        clients = await ClientRepository.GetAllAsync();
        Console.WriteLine($"Загружено: {clients?.Count} клиентов");
    }

    private async Task LoadClients()
    {
        clients = await ClientRepository.GetAllAsync();
        StateHasChanged();
    }

    private async Task HandleDeleteClick(int id)
    {
        deletingId = id;
        errorMessage = null;
        StateHasChanged();
        
        try
        {
            await ClientRepository.DeleteAsync(id);
            await LoadClients();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            deletingId = null;
            StateHasChanged();
        }
    }
}